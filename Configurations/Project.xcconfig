MARKETING_VERSION = 0.11.5
CURRENT_PROJECT_VERSION = 154
POSTHOG_API_KEY =
POSTHOG_HOST =
SUPACODE_RELEASE_DAY =
SENTRY_DSN =

// Fork: upstream license enforcement stays off by default. Set YES (here or in an
// XCODE_XCCONFIG_FILE override) to build a Release with upstream licensing. Debug never enforces.
SUPACODE_LICENSE_ENFORCED = NO
SUPACODE_LICENSE_CONDITION_YES = SUPACODE_LICENSE_ENFORCED
SUPACODE_LICENSE_CONDITION_NO =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(SUPACODE_LICENSE_CONDITION_$(SUPACODE_LICENSE_ENFORCED))
